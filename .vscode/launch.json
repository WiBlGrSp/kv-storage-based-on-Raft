{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Raft",
            "program": "${workspaceFolder}/build/raft",
            "args": [
                "--listen=1@127.0.0.1:50051",
                "--peer=2@127.0.0.1:50052",  
                "--peer=3@127.0.0.1:50053"
            ],
            "cwd": "${workspaceFolder}",
            "stopOnEntry": false
        }
    ]
}